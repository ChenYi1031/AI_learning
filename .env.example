# EdgeOne Pages Node Functions 环境变量模板
# 复制为 .env（已被 .gitignore 忽略）供 `edgeone pages dev` 本地调试；
# 线上环境在 EdgeOne 控制台 → 项目设置 → 环境变量 中配置同样的键值。

# Turso 数据库地址，形如 https://<db-name>-<org>.turso.io
TURSO_DB_URL=

# Turso 数据库 Token（turso db tokens create 或控制台生成）
TURSO_AUTH_TOKEN=

# 与 sync.js 中 APP_KEY 常量保持一致的个人站点共享密钥
APP_KEY=ail_d5207a4bbb992bf9405c68ef2e50ed93
